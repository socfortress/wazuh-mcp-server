# Wazuh MCP Server Environment Configuration
# Copy this file to .env and fill in your actual values

# OpenAI Configuration (if using with OpenAI assistants)
# OPENAI_API_KEY=your-openai-api-key-here

# Wazuh Manager Configuration
WAZUH_PROD_URL=https://your-wazuh-manager:55000
WAZUH_PROD_USERNAME=your-username
WAZUH_PROD_PASSWORD=your-password
WAZUH_PROD_SSL_VERIFY=false
WAZUH_PROD_TIMEOUT=30

# MCP Server Configuration
MCP_TRANSPORT=stdio            # or http
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000
# MCP_AUTH_TOKEN=               # required for http: openssl rand -hex 32
# MCP_MAX_OUTPUT_CHARS=32000

# Logging Configuration
LOG_LEVEL=INFO

# Tool Filtering (optional)
# WAZUH_DISABLED_TOOLS=GetRuleFileContentTool
# WAZUH_DISABLED_CATEGORIES=sca            # auth, agents, rules, sca
# WAZUH_READ_ONLY=false
